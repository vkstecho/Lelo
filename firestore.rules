rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.phone_number in ['+918929394920'];
      // Add more admin numbers to this list if needed, e.g.:
      // request.auth.token.phone_number in ['+918929394920', '+91XXXXXXXXXX'];
    }

    // Categories - anyone can browse, only admin can add/edit/delete
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Products - anyone can browse, only admin can add/edit/delete
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders - anyone (even not logged in) can CREATE an order, but only
    // admin can read the order list, or update/cancel an order.
    // This is what lets customers place orders with no login at all.
    match /orders/{orderId} {
      allow read, update, delete: if isAdmin();

      allow create: if
        request.resource.data.keys().hasAll(['items','subtotal','phone','status','createdAt']) &&
        request.resource.data.status == 'new' &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() == 10 &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.subtotal is number &&
        request.resource.data.subtotal >= 0;
    }
  }
}
